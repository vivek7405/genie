# Copy to .env and fill in your values: cp .env.example .env

PORT=8080
DATABASE_URL=file:./db/dev.db

# Signs the session cookie. The app refuses to boot without it.
# Generate: bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# The OAuth client of a GitHub App. Callback URL: <origin>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Acts on your repositories (repo scope). Only the owner of this token can sign in.
GH_TOKEN=

# Runs the task machines.
PILOT_API_KEY=

# From `claude setup-token`. Handed to Claude Code as the env of one exec.
CLAUDE_CODE_OAUTH_TOKEN=

# GENIE_WORKER=0 boots the UI without the worker.
GENIE_WORKER=1
# How many tasks run at once across repositories. Keep 1 on a subscription token.
GENIE_CONCURRENCY=1
# The model a run consults at its decision points.
# GENIE_ADVISOR_MODEL=fable
