# webjs environment variables
# Copy to .env and fill in your values: cp .env.example .env
#
# Opinionated defaults: set these and the framework auto-configures.

# ── Server ──────────────────────────────────────────────────────────
PORT=8080

# ── Sign in with GitHub (required) ──────────────────────────────────
# Signs the session cookie. Required in every environment; the app refuses
# to boot without it. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# The GitHub App's OAuth client id and secret (the App's settings page, not
# a separate OAuth App). Its callback URL is <origin>/api/auth/callback/github.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# `npm run db:seed` hands the demo project to this GitHub login.
# GENIE_DEV_USER_LOGIN=vivek7405

# ── Redis (production scaling) ──────────────────────────────────────
# Set this and cache, sessions, rate limiting, and pub/sub all
# automatically use Redis. Without it, everything uses in-memory
# defaults (great for development).
# REDIS_URL=redis://localhost:6379

# ── Database ────────────────────────────────────────────────────────
# Used by Drizzle. SQLite for dev, PostgreSQL for production (--db postgres).
DATABASE_URL=file:./db/dev.db

# ── Genie ───────────────────────────────────────────────────────────
# GENIE_WORKER=0 boots the UI without the pipeline worker.
GENIE_WORKER=1
# How many tasks the worker drives at once. Keep 1 on a subscription token.
GENIE_CONCURRENCY=1
# Worker poll interval.
GENIE_TICK_MS=2000
# A stage whose claim went stale this many times is failed instead of re-claimed.
GENIE_MAX_ATTEMPTS=3
# On SIGTERM, how long the worker waits for in-flight stages before it
# releases their claims for the next boot. Keep it under the framework's 10 s exit.
GENIE_DRAIN_MS=8000
# Build stage budget for one Claude run (default 45 minutes).
GENIE_BUILD_TIMEOUT_MS=2700000
# How long to wait for a pilots PR preview before serving from the task machine.
GENIE_PREVIEW_TIMEOUT_MS=600000
# Machine URL suffix used for the preview fallback.
PILOTS_URL_SUFFIX=.pilotrun.app
# GENIE_SELF_REVIEW=0 skips the self-review (/code-review --fix --comment) of
# each pull request before it reaches Review.
GENIE_SELF_REVIEW=1
# ── pilots and Claude Code (M3) ─────────────────────────────────────
# The pilots API key. Every machine genie creates is named genie-*, so a
# restricted key minted with name_prefix genie- works here later.
PILOT_API_KEY=
# Also used to read the services list for the production URL shown after a merge.
# PILOT_API_URL=https://api.pilotrun.app
# From `claude setup-token`: a subscription token starting sk-ant-oat. It is
# handed to Claude Code as the env of one exec inside the task machine.
CLAUDE_CODE_OAUTH_TOKEN=
# Build every task machine from scratch instead of forking the base checkpoint.
# GENIE_PILOTS_FORK=0
# `npm run cleanup:machines` destroys the machine of a task that failed, or a
# genie- machine no task knows, once it is older than this many days.
GENIE_CLEANUP_DAYS=3

# ── GitHub App ──────────────────────────────────────────────────────
# Genie acts on GitHub as a GitHub App: people sign in with it, the connect
# page lists their installations, and every repository call, every push and
# every comment from a task machine carries an installation token. Register
# one App with Contents, Issues, Pull requests and Metadata (repository) plus
# Projects (organization) read and write, a Setup URL of
# <your origin>/dashboard/projects/new, and "Request user authorization
# (OAuth) during installation". AUTH_GITHUB_ID and AUTH_GITHUB_SECRET are
# that App's OAuth client id and secret (the sign-in half of #32).
# The App's numeric id (Settings, Developer settings, GitHub Apps).
GITHUB_APP_ID=
# The slug in the App's URL, https://github.com/apps/<slug>.
GITHUB_APP_SLUG=
# The private key PEM as generated by GitHub. One line with \n escapes is
# accepted, and so is the multi-line file.
GITHUB_APP_PRIVATE_KEY=
# Without the three above, Genie falls back to the single operator token
# below for everything (no sign-in gate, the owner/name connect form).
# ── GitHub token (fallback without an App) ──────────────────────────
# One token serves the sync and the task machines: classic scopes repo +
# project (or a fine-grained token with Contents, Issues, Pull requests and
# Projects read/write on the connected repos). The sync falls back to
# `gh auth token` when unset. Inside a machine it is the env of one exec,
# never a file. Also the token for a project connected before the App.
GH_TOKEN=
# GENIE_SYNC=0 boots without the GitHub sync loop (tests do).
GENIE_SYNC=1
# GitHub poll interval.
GENIE_SYNC_MS=30000

# ── Pilots deploy ───────────────────────────────────────────────────
# compose.pilots.yaml carries the credentials as secret:// references.
# Set each one in this directory (the value is prompted, never an argument):
#   pilot secret set pilot_api_key              # PILOT_API_KEY
#   pilot secret set claude_code_oauth_token    # CLAUDE_CODE_OAUTH_TOKEN
#   pilot secret set github_app_id              # GITHUB_APP_ID
#   pilot secret set github_app_slug            # GITHUB_APP_SLUG
#   pilot secret set github_app_private_key     # GITHUB_APP_PRIVATE_KEY
#   pilot secret set github_token               # GH_TOKEN (the fallback)
#   pilot secret set auth_secret                # AUTH_SECRET
#   pilot secret set auth_github_id             # AUTH_GITHUB_ID
#   pilot secret set auth_github_secret         # AUTH_GITHUB_SECRET
