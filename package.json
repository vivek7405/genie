{
  "name": "genie",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "css:build": "tailwindcss -i ./public/input.css -o ./public/tailwind.css --minify",
    "gallery:clear": "node scripts/clear-gallery.mjs",
    "dev": "webjs dev",
    "start": "webjs start",
    "test": "webjs test",
    "test:server": "webjs test --server",
    "test:browser": "webjs test --browser",
    "check": "webjs check",
    "typecheck": "webjs typecheck",
    "doctor": "webjs doctor",
    "ci": "webjs ci",
    "db:generate": "webjs db generate",
    "db:migrate": "webjs db migrate",
    "db:push": "webjs db push",
    "db:studio": "webjs db studio",
    "db:seed": "webjs db seed",
    "pilots:smoke": "node --env-file-if-exists=.env scripts/pilots-smoke.ts",
    "cleanup:machines": "node --env-file-if-exists=.env scripts/cleanup-machines.ts",
    "demo:reset": "node --env-file-if-exists=.env scripts/demo-reset.ts"
  },
  "dependencies": {
    "@pilots/sdk": "^0.1.1",
    "@webjsdev/cli": "latest",
    "@webjsdev/core": "^0.7.54",
    "@webjsdev/server": "latest",
    "drizzle-orm": "1.0.0-rc.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@types/node": "^24.0.0",
    "@web/test-runner": "^0.20.0",
    "@web/test-runner-playwright": "^0.11.0",
    "@webjsdev/intellisense": "latest",
    "axe-core": "^4.10.0",
    "drizzle-kit": "1.0.0-rc.3",
    "playwright": "^1.59.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "puppeteer-core": "^25.7.0"
  },
  "webjs": {
    "dev": {
      "before": [
        "webjs db migrate",
        "tailwindcss -i ./public/input.css -o ./public/tailwind.css --minify"
      ],
      "regenerate": [
        {
          "output": "public/tailwind.css",
          "command": "tailwindcss -i ./public/input.css -o ./public/tailwind.css --minify",
          "inputs": [
            "app",
            "components",
            "modules",
            "lib",
            "public/input.css"
          ]
        }
      ]
    },
    "start": {
      "before": [
        "webjs db migrate",
        "tailwindcss -i ./public/input.css -o ./public/tailwind.css --minify"
      ]
    },
    "doctor": {
      "gate": {
        "UNMARKED_ASSET_LINKS": "error"
      }
    },
    "ci": {
      "steps": [
        {
          "title": "Setup",
          "run": "webjs db migrate"
        },
        {
          "title": "Checks",
          "parallel": 2,
          "steps": [
            {
              "title": "Conventions",
              "run": "webjs check"
            },
            {
              "title": "Health",
              "run": "webjs doctor"
            },
            {
              "title": "Types",
              "run": "webjs typecheck"
            },
            {
              "title": "Security: dependency audit",
              "run": "npm audit --audit-level=high"
            },
            {
              "title": "Tests",
              "steps": [
                {
                  "title": "Tests: server",
                  "run": "webjs test --server"
                },
                {
                  "title": "Tests: browser",
                  "run": "webjs test --browser"
                },
                {
                  "title": "Tests: e2e",
                  "run": "webjs test --server",
                  "env": {
                    "WEBJS_E2E": "1"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
